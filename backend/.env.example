APP_NAME=ResearchAI
APP_VERSION=1.0.0
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173,https://researchai-app.vercel.app
ENVIRONMENT=development

# AI provider fallback configuration (Groq -> OpenRouter -> Mistral)
# Keep actual API keys in .env or your deployment provider's secret settings.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
