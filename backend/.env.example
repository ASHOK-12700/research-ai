APP_NAME=ResearchAI
APP_VERSION=1.0.0
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# AI/RAG Configuration (for Ask Your Papers)
AI_MODEL=meta/llama-3.2-3b-instruct
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Chatbot Configuration (for ResearchAI Copilot)
# Do NOT commit your actual API key - add it to .env locally only
CHATBOT_API_KEY=your_chatbot_api_key_here
CHATBOT_MODEL=openai/gpt-oss-20b
CHATBOT_BASE_URL=https://integrate.api.nvidia.com/v1
